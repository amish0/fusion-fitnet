<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - Fusion FitNet</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700&family=Poppins:wght@400;600&display=swap">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
  <style>
    .product-detail-page {
      max-width: 1200px;
      margin: 100px auto 60px;
      padding: 0 20px;
    }

    .product-detail-container {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 50px;
      background: white;
      border-radius: 20px;
      padding: 40px;
      box-shadow: 0 10px 40px rgba(0,0,0,0.1);
    }

    .product-image-section {
      position: relative;
    }

    .product-main-image {
      width: 100%;
      height: 500px;
      border-radius: 15px;
      overflow: hidden;
      background: #f5f5f5;
      box-shadow: 0 5px 20px rgba(0,0,0,0.1);
      margin-bottom: 15px;
    }

    .product-main-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      cursor: pointer;
      transition: transform 0.3s ease;
    }

    .product-main-image img:hover {
      transform: scale(1.05);
    }

    .product-thumbnails {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));
      gap: 10px;
    }

    .thumbnail {
      width: 100%;
      height: 80px;
      border-radius: 8px;
      overflow: hidden;
      cursor: pointer;
      border: 3px solid transparent;
      transition: all 0.3s ease;
    }

    .thumbnail:hover,
    .thumbnail.active {
      border-color: #667eea;
      box-shadow: 0 3px 10px rgba(102, 126, 234, 0.3);
    }

    .thumbnail img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .product-details-section {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .product-category-badge {
      display: inline-block;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      padding: 8px 16px;
      border-radius: 20px;
      font-size: 0.85rem;
      font-weight: 600;
      text-transform: uppercase;
      margin-bottom: 15px;
    }

    .product-title {
      font-size: 2.5rem;
      color: #333;
      margin-bottom: 20px;
      line-height: 1.2;
    }

    .product-price-section {
      background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
      padding: 20px;
      border-radius: 15px;
      margin: 20px 0;
    }

    .product-price-label {
      font-size: 0.9rem;
      color: #666;
      margin-bottom: 5px;
    }

    .product-price-value {
      font-size: 2.5rem;
      font-weight: bold;
      color: #764ba2;
    }

    .product-stock-info {
      padding: 15px;
      border-radius: 10px;
      margin: 20px 0;
      font-weight: 600;
    }

    .stock-available {
      background: #d4edda;
      color: #155724;
      border: 2px solid #c3e6cb;
    }

    .stock-unavailable {
      background: #f8d7da;
      color: #721c24;
      border: 2px solid #f5c6cb;
    }

    .product-description {
      margin: 20px 0;
      line-height: 1.8;
      color: #555;
      font-size: 1.05rem;
    }

    .product-features {
      margin: 30px 0;
    }

    .product-features h3 {
      font-size: 1.3rem;
      color: #667eea;
      margin-bottom: 15px;
    }

    .features-list {
      list-style: none;
      padding: 0;
    }

    .features-list li {
      padding: 10px 0;
      padding-left: 30px;
      position: relative;
      color: #555;
    }

    .features-list li:before {
      content: "✓";
      position: absolute;
      left: 0;
      color: #667eea;
      font-weight: bold;
      font-size: 1.2rem;
    }

    .product-actions {
      display: flex;
      gap: 15px;
      margin-top: 30px;
    }

    .btn-add-cart {
      flex: 1;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      border: none;
      padding: 15px 30px;
      border-radius: 10px;
      font-size: 1.1rem;
      font-weight: 600;
      cursor: pointer;
      transition: transform 0.3s, box-shadow 0.3s;
    }

    .btn-add-cart:hover {
      transform: translateY(-3px);
      box-shadow: 0 10px 25px rgba(102, 126, 234, 0.4);
    }

    .btn-add-cart:disabled {
      background: #ccc;
      cursor: not-allowed;
      transform: none;
    }

    .btn-back {
      background: #f5f5f5;
      color: #333;
      border: 2px solid #ddd;
      padding: 15px 30px;
      border-radius: 10px;
      font-size: 1.1rem;
      font-weight: 600;
      cursor: pointer;
      text-decoration: none;
      display: inline-block;
      text-align: center;
      transition: all 0.3s;
    }

    .btn-back:hover {
      background: #667eea;
      color: white;
      border-color: #667eea;
    }

    .quantity-selector {
      display: flex;
      align-items: center;
      gap: 15px;
      margin: 20px 0;
    }

    .quantity-selector label {
      font-weight: 600;
      color: #333;
    }

    .quantity-input {
      display: flex;
      align-items: center;
      border: 2px solid #ddd;
      border-radius: 8px;
      overflow: hidden;
    }

    .quantity-btn {
      background: #f5f5f5;
      border: none;
      padding: 10px 15px;
      cursor: pointer;
      font-size: 1.2rem;
      transition: background 0.3s;
    }

    .quantity-btn:hover {
      background: #667eea;
      color: white;
    }

    .quantity-value {
      padding: 10px 20px;
      font-weight: 600;
      min-width: 50px;
      text-align: center;
    }

    @media (max-width: 768px) {
      .product-detail-container {
        grid-template-columns: 1fr;
        gap: 30px;
        padding: 20px;
      }
      
      .product-title {
        font-size: 2rem;
      }
      
      .product-main-image {
        height: 350px;
      }
      
      .product-actions {
        flex-direction: column;
      }
    }
  </style>
</head>
<body>

<header>
  <h1>Fusion FitNet</h1>
  <p class="tagline">Fitness • Strength • Transformation</p>
</header>

<nav class="navbar">
  <div class="logo">Fusion FitNet</div>
  <div class="menu-toggle" onclick="toggleMenu()">☰</div>

  <div class="nav-links" id="navLinks">
    <a href="/">Home</a>
    <a href="/#features">Features</a>
    <a href="/gallery">Gallery</a>
    <a href="/#events">Events</a>
    <a href="/#team">Our Team</a>
    <a href="/products">Products</a>
    <a href="/#contact">Contact</a>

    <% if (isLoggedIn) { %>
      <a href="/cart">🛒 Cart</a>
      <a href="/dashboard" class="btn-login">My Account</a>
      <a href="/auth/logout" class="btn-signup">Logout</a>
    <% } else { %>
      <a href="/auth/login" class="btn-login">Login</a>
      <a href="/auth/signup" class="btn-signup">Sign Up</a>
    <% } %>
  </div>
</nav>

<section class="product-detail-page">
  <div class="product-detail-container">
    <!-- Product Image -->
    <div class="product-image-section">
      <div class="product-main-image">
        <img id="mainProductImage" src="<%= product.images && product.images.length > 0 ? product.images[0] : product.image_url %>" alt="<%= product.name %>">
      </div>
      
      <!-- Thumbnails for multiple images -->
      <% if (product.images && product.images.length > 1) { %>
        <div class="product-thumbnails">
          <% product.images.forEach((img, index) => { %>
            <div class="thumbnail <%= index === 0 ? 'active' : '' %>" onclick="changeProductImage('<%= img %>', this)">
              <img src="<%= img %>" alt="<%= product.name %> - Image <%= index + 1 %>">
            </div>
          <% }); %>
        </div>
      <% } %>
    </div>

    <!-- Product Details -->
    <div class="product-details-section">
      <div>
        <span class="product-category-badge"><%= product.category || 'General' %></span>
        <h1 class="product-title"><%= product.name %></h1>
        
        <div class="product-price-section">
          <p class="product-price-label">Price</p>
          <p class="product-price-value">$<%= parseFloat(product.price).toFixed(2) %></p>
        </div>

        <% if (product.stock > 0) { %>
          <div class="product-stock-info stock-available">
            <i class="fas fa-check-circle"></i> In Stock - <%= product.stock %> units available
          </div>
        <% } else { %>
          <div class="product-stock-info stock-unavailable">
            <i class="fas fa-times-circle"></i> Currently Out of Stock
          </div>
        <% } %>

        <div class="product-description">
          <p><%= product.description || 'No description available for this product.' %></p>
        </div>

        <div class="product-features">
          <h3>Key Features</h3>
          <ul class="features-list">
            <li>High-quality fitness equipment</li>
            <li>Durable and long-lasting</li>
            <li>Perfect for home or gym use</li>
            <li>Easy to use and maintain</li>
          </ul>
        </div>
      </div>

      <div>
        <% if (product.stock > 0) { %>
          <div class="quantity-selector">
            <label for="quantity">Quantity:</label>
            <div class="quantity-input">
              <button class="quantity-btn" onclick="decreaseQuantity()">−</button>
              <span class="quantity-value" id="quantityValue">1</span>
              <button class="quantity-btn" onclick="increaseQuantity(<%= product.stock %>)">+</button>
            </div>
          </div>
        <% } %>

        <div class="product-actions">
          <a href="/products" class="btn-back">← Back to Products</a>
          <% if (product.stock > 0) { %>
            <button class="btn-add-cart" onclick="addToCart(<%= product.id %>)">
              <i class="fas fa-shopping-cart"></i> Add to Cart
            </button>
          <% } else { %>
            <button class="btn-add-cart" disabled>Out of Stock</button>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</section>

<footer>
  <p>&copy; 2024 Fusion FitNet. All rights reserved.</p>
</footer>

<script src="/js/main.js"></script>
<script>
  let quantity = 1;

  function changeProductImage(imageUrl, thumbnailElement) {
    document.getElementById('mainProductImage').src = imageUrl;
    
    // Update active thumbnail
    document.querySelectorAll('.thumbnail').forEach(t => t.classList.remove('active'));
    if (thumbnailElement) {
      thumbnailElement.classList.add('active');
    }
  }

  function increaseQuantity(maxStock) {
    if (quantity < maxStock) {
      quantity++;
      document.getElementById('quantityValue').textContent = quantity;
    }
  }

  function decreaseQuantity() {
    if (quantity > 1) {
      quantity--;
      document.getElementById('quantityValue').textContent = quantity;
    }
  }

  function addToCart(productId) {
    if (!<%= isLoggedIn ? 'true' : 'false' %>) {
      alert('Please login to add items to cart');
      window.location.href = '/auth/login';
      return;
    }

    alert(`Added ${quantity} item(s) to cart! (Cart functionality coming soon)`);
  }
</script>

</body>
</html>
