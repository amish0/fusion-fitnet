<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700&family=Poppins:wght@400;600&display=swap">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
</head>
<body>

<header>
  <h1>Fusion FitNet</h1>
  <p class="tagline">Fitness • Strength • Transformation</p>
</header>

<nav class="navbar">
  <div class="logo">Fusion FitNet</div>
  <div class="menu-toggle" onclick="toggleMenu()">☰</div>

  <div class="nav-links" id="navLinks">
    <a href="/#features">Features</a>
    <a href="/#gallery">Gallery</a>
    <a href="/#events">Events</a>
    <a href="/#products">Products</a>
    <a href="/contact">Contact</a>

    <% if (isLoggedIn) { %>
      <a href="/cart">🛒 Cart</a>
      <a href="/dashboard" class="btn-login">My Account</a>
      <a href="/auth/logout" class="btn-signup">Logout</a>
    <% } else { %>
      <a href="/auth/login" class="btn-login">Login</a>
      <a href="/auth/signup" class="btn-signup">Sign Up</a>
    <% } %>
  </div>
</nav>

<section class="hero" id="top">
  <div class="hero-media">
    <% if (settings && settings.hero_video_url) { %>
      <video class="hero-video" src="<%= settings.hero_video_url %>" <%= settings.hero_video_poster ? `poster="${settings.hero_video_poster}"` : '' %> autoplay muted loop playsinline></video>
    <% } else { %>
      <div class="hero-fallback"></div>
    <% } %>
    <div class="hero-gradient"></div>
  </div>
  <div class="hero-content">
    <p class="hero-kicker">Science-led training • Member-first experience</p>
    <h1><%= (settings && settings.hero_headline) || 'Train Smart. Move Strong. Recover Faster.' %></h1>
    <p class="hero-sub"><%= (settings && settings.hero_subheadline) || 'Blending coaching, community, and data to deliver results you can measure.' %></p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="/products">Shop Featured Gear</a>
      <a class="btn btn-ghost" href="/contact">Book a Consultation</a>
    </div>
    <div class="hero-metrics">
      <div>
        <strong>5k+</strong>
        <span>Training Sessions</span>
      </div>
      <div>
        <strong>98%</strong>
        <span>Member Satisfaction</span>
      </div>
      <div>
        <strong>24/7</strong>
        <span>Access & Support</span>
      </div>
    </div>
  </div>
</section>

<section id="about" class="about">
  <div class="about-content">
    <div>
      <p class="eyebrow">About Fusion FitNet</p>
      <h2>Human coaches, scientific programming, measurable progress.</h2>
      <p class="lead">We combine expert coaching, sports science, and community accountability. Every session, plan, and product is curated to keep you moving better—on and off the floor.</p>
      <div class="about-list">
        <div class="about-item">
          <i class="fas fa-dna"></i>
          <div>
            <h4>Science-backed methods</h4>
            <p>Periodized programming, recovery protocols, and movement screens.</p>
          </div>
        </div>
        <div class="about-item">
          <i class="fas fa-heartbeat"></i>
          <div>
            <h4>Holistic health</h4>
            <p>Strength, conditioning, mobility, and nutrition guidance in one place.</p>
          </div>
        </div>
        <div class="about-item">
          <i class="fas fa-chart-line"></i>
          <div>
            <h4>Data you can see</h4>
            <p>Track progress with coach feedback and session analytics.</p>
          </div>
        </div>
      </div>
    </div>
    <div class="about-card">
      <div class="about-badge">Member Spotlight</div>
      <h3>“I hit PRs without burning out.”</h3>
      <p>“The coaching cues and recovery work made the difference. I finally train smarter.”</p>
      <div class="about-meta">
        <span>Kayla M.</span>
        <span>Strength & Conditioning</span>
      </div>
    </div>
  </div>
</section>

<section id="features">
  <h2>Why Choose Fusion FitNet?</h2>
  <div class="features">
    <div class="feature-card">
      <i class="fas fa-dumbbell"></i>
      <h3>Personalized Training</h3>
      <p>Custom workouts and plans designed to match your fitness level and goals.</p>
      <a href="/contact" class="btn">Join Now</a>
    </div>
    <div class="feature-card">
      <i class="fas fa-trophy"></i>
      <h3>Expert Coaches</h3>
      <p>Learn from certified trainers with years of experience in strength and wellness.</p>
      <a href="/contact" class="btn">Meet Our Coaches</a>
    </div>
    <div class="feature-card">
      <i class="fas fa-users"></i>
      <h3>Community Support</h3>
      <p>Connect with thousands of members on their fitness journey and reach goals together.</p>
      <a href="/contact" class="btn">Join Community</a>
    </div>
  </div>
</section>

<section id="gallery">
  <h2>Our Facility & Members</h2>
  <div class="gallery swipe" id="swipeGallery">
    <% if (gallery && gallery.length > 0) { %>
      <% gallery.slice(0, 8).forEach((item, index) => { %>
        <img src="<%= item.image_url %>" alt="<%= item.title %>" onclick="openGalleryModal(<%= index %>)" style="cursor: pointer;">
      <% }); %>
    <% } else { %>
      <p>Gallery loading... Admin can feature images from the admin dashboard.</p>
    <% } %>
  </div>
  <div style="text-align: center; margin-top: 30px;">
    <a href="/gallery" class="btn btn-primary">View Full Gallery</a>
  </div>
</section>

<section id="events">
  <h2>Upcoming Events</h2>
  <div class="events-list">
    <% if (events && events.length > 0) { %>
      <% events.forEach(event => { %>
        <div class="event-card">
          <h3><%= event.title %></h3>
          <p><strong>Date:</strong> <%= event.date %></p>
          <p><strong>Time:</strong> <%= event.time %></p>
          <p><%= event.description %></p>
          <button class="btn" onclick="registerEvent(<%= event.id %>)">Register</button>
        </div>
      <% }); %>
    <% } else { %>
      <p>No upcoming events at the moment.</p>
    <% } %>
  </div>
</section>

<section id="products">
  <h2>Featured Products</h2>
  <div class="products-grid">
    <% if (products && products.length > 0) { %>
      <% products.slice(0, 5).forEach(product => { %>
        <div class="product-card">
          <div class="product-image-carousel">
            <% if (product.images && product.images.length > 0) { %>
              <% product.images.forEach((img, idx) => { %>
                <img src="<%= img %>" alt="<%= product.name %>" class="carousel-image <%= idx === 0 ? 'active' : '' %>" data-index="<%= idx %>">
              <% }); %>
              <% if (product.images.length > 1) { %>
                <div class="carousel-indicators">
                  <% product.images.forEach((img, idx) => { %>
                    <span class="indicator <%= idx === 0 ? 'active' : '' %>" data-index="<%= idx %>"></span>
                  <% }); %>
                </div>
              <% } %>
            <% } else { %>
              <img src="<%= product.image_url %>" alt="<%= product.name %>" class="carousel-image active">
            <% } %>
          </div>
          <div class="product-info">
            <h3><%= product.name %></h3>
            <p class="product-category"><%= product.category || 'General' %></p>
            <p class="product-price">$<%= parseFloat(product.price).toFixed(2) %></p>
            <a href="/products/<%= product.id %>" class="btn">View Details</a>
          </div>
        </div>
      <% }); %>
    <% } else { %>
      <p style="text-align: center; color: #666;">No products available.</p>
    <% } %>
  </div>
  <div style="text-align: center; margin-top: 30px;">
    <a href="/products" class="btn btn-primary">View All Products</a>
  </div>
</section>

<section id="blog">
  <h2>Latest Blog Posts</h2>
  <div class="blog-list">
    <% if (blog && blog.length > 0) { %>
      <% blog.slice(0, 3).forEach(post => { %>
        <article class="blog-card">
          <h3><%= post.title %></h3>
          <p class="date"><%= post.date %></p>
          <p><%= post.excerpt %></p>
          <a href="#" class="read-more">Read More →</a>
        </article>
      <% }); %>
    <% } %>
  </div>
</section>

<section class="cta-band">
  <div class="cta-content">
    <div>
      <p class="eyebrow">Ready to get started?</p>
      <h2>Book a consult and get a personalized plan.</h2>
      <p class="lead">Tell us your goals. We'll map training, recovery, and gear for your next milestone.</p>
    </div>
    <div class="cta-actions">
      <a class="btn btn-primary" href="/contact">Talk to a Coach</a>
      <a class="btn btn-ghost" href="/products">Browse Gear</a>
    </div>
  </div>
</section>

<footer class="footer">
  <div class="footer-left">
    <h3>Fusion FitNet</h3>
    <p>Fitness • Strength • Transformation</p>
  </div>
  <div class="footer-contact">
    <h4>Contact</h4>
    <p>123 Fitness Street, Gym City</p>
    <p>+1 (555) 123-4567</p>
    <p><a href="mailto:info@fusionfitnet.com">info@fusionfitnet.com</a></p>
    <a href="/contact" class="footer-link">Contact Page</a>
  </div>
  <div class="footer-links">
    <h4>Explore</h4>
    <a href="/#about">About</a>
    <a href="/#products">Featured Products</a>
    <a href="/#events">Events</a>
    <a href="/#gallery">Gallery</a>
  </div>
</footer>

<script src="/js/main.js"></script>
<script src="/js/slider.js"></script>
<script src="/js/gallery.js"></script>
<script src="/js/team.js"></script>
<script src="/js/blog.js"></script>
<script src="/js/events.js"></script>

<!-- Gallery Modal -->
<div id="galleryModal" class="modal" style="display: none; position: fixed; z-index: 10000; left: 0; top: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.95); align-items: center; justify-content: center;">
  <span class="close-modal" onclick="closeGalleryModal()" style="position: absolute; top: 20px; right: 40px; color: white; font-size: 40px; font-weight: bold; cursor: pointer; z-index: 10001;">&times;</span>
  <button class="modal-nav modal-prev" onclick="changeGalleryImage(-1)" style="position: absolute; top: 50%; left: 20px; transform: translateY(-50%); background: rgba(255,255,255,0.2); color: white; border: none; font-size: 30px; padding: 15px 20px; cursor: pointer; border-radius: 5px; z-index: 10001;">❮</button>
  <button class="modal-nav modal-next" onclick="changeGalleryImage(1)" style="position: absolute; top: 50%; right: 20px; transform: translateY(-50%); background: rgba(255,255,255,0.2); color: white; border: none; font-size: 30px; padding: 15px 20px; cursor: pointer; border-radius: 5px; z-index: 10001;">❯</button>
  <div class="modal-content" style="display: flex; align-items: center; justify-content: center; flex-direction: column; max-width: 90%; max-height: 90%;">
    <img id="galleryModalImage" src="" alt="" style="max-width: 100%; max-height: 85vh; object-fit: contain;">
    <div class="modal-caption" id="galleryModalCaption" style="color: white; text-align: center; padding: 15px; font-size: 1.2rem;"></div>
  </div>
</div>

<script>
const homeGalleryData = <%- JSON.stringify(gallery || []) %>;
let currentGalleryIndex = 0;

function openGalleryModal(index) {
  currentGalleryIndex = index;
  const modal = document.getElementById('galleryModal');
  const modalImg = document.getElementById('galleryModalImage');
  const caption = document.getElementById('galleryModalCaption');
  
  modal.style.display = 'flex';
  modalImg.src = homeGalleryData[index].image_url;
  caption.textContent = homeGalleryData[index].title;
  document.body.style.overflow = 'hidden';
}

function closeGalleryModal() {
  const modal = document.getElementById('galleryModal');
  modal.style.display = 'none';
  document.body.style.overflow = 'auto';
}

function changeGalleryImage(direction) {
  currentGalleryIndex += direction;
  const displayLimit = 8;
  const maxIndex = Math.min(homeGalleryData.length, displayLimit) - 1;
  
  if (currentGalleryIndex < 0) {
    currentGalleryIndex = maxIndex;
  } else if (currentGalleryIndex > maxIndex) {
    currentGalleryIndex = 0;
  }
  
  const modalImg = document.getElementById('galleryModalImage');
  const caption = document.getElementById('galleryModalCaption');
  modalImg.src = homeGalleryData[currentGalleryIndex].image_url;
  caption.textContent = homeGalleryData[currentGalleryIndex].title;
}

// Keyboard navigation for gallery modal
document.addEventListener('keydown', (e) => {
  const modal = document.getElementById('galleryModal');
  if (modal && modal.style.display === 'flex') {
    if (e.key === 'Escape') closeGalleryModal();
    if (e.key === 'ArrowLeft') changeGalleryImage(-1);
    if (e.key === 'ArrowRight') changeGalleryImage(1);
  }
});

function submitContact(e) {
  e.preventDefault();
  const formData = new FormData(document.getElementById('contactForm'));
  const data = {
    name: formData.get('name'),
    email: formData.get('email'),
    subject: formData.get('subject'),
    message: formData.get('message')
  };

  fetch('/contact/submit', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(data)
  })
  .then(r => r.json())
  .then(res => {
    alert(res.message);
    if (res.success) document.getElementById('contactForm').reset();
  })
  .catch(err => alert('Error: ' + err));
}

function registerEvent(eventId) {
  alert('Event registration feature coming soon!');
}
</script>

</body>
</html>
